# setup.sh генерує секрети. Ніколи не комітьте .env.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SCHOOL_REGISTRATION_ENABLED=True
INITIAL_SETUP_ENABLED=True
# setup.sh генерує цей одноразовий код; введіть його у браузері при першому запуску.
INITIAL_SETUP_TOKEN=
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=schooljournal_db
POSTGRES_USER=journal_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
COMPOSE_PROJECT_NAME=schooljournal
WEB_BIND=0.0.0.0
WEB_PORT=8085
SEED_DEMO_DATA=False

# Optional server-to-server roster integration. Generate separate long tokens.
# Browser URLs and internal API URLs differ; never put these tokens in frontend JS.
INTEGRATION_NETWORK=school-integration
ROSTER_SYNC_TOKEN=
ROSTER_PEERS=[]
ROSTER_SYNC_INTERVAL=30
# ROSTER_PEERS is a JSON array: [{"url":"http://peer-alias:8000/api/v2/roster-sync/","token":"peer-server-token"}]
ROSTER_SCHOOL_ID=0
ROSTER_YEAR_ID=0
# Set the exact local school/year IDs before sharing classes. 0 disables roster scope.
