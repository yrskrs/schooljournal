# setup.sh генерує секрети. Ніколи не комітьте .env.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,schooljournal-api
# Дозволити зміну приватної LAN IP без wildcard; для лише явних доменів задайте False.
ALLOW_PRIVATE_NETWORK_HOSTS=True
# Для LAN запустіть ./setup.sh --public-url http://IP-СЕРВЕРА:8085
CSRF_TRUSTED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SCHOOL_REGISTRATION_ENABLED=True
INITIAL_SETUP_ENABLED=True
# setup.sh генерує цей одноразовий код; введіть його у браузері при першому запуску.
INITIAL_SETUP_TOKEN=
# Лише для явно дозволеного відновлення на сервері; 0 вимикає режим.
# Після налаштування потрібна команда prepare_admin_recovery; самого ID недостатньо.
INITIAL_SETUP_RECOVERY_USER_ID=0
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=schooljournal_db
POSTGRES_USER=journal_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
COMPOSE_PROJECT_NAME=schooljournal
WEB_BIND=0.0.0.0
WEB_PORT=8085
SEED_DEMO_DATA=False

# Optional server-to-server roster integration. Generate separate long tokens.
# Browser URLs and internal API URLs differ; never put these tokens in frontend JS.
INTEGRATION_NETWORK=school-integration
ROSTER_SYNC_TOKEN=
ROSTER_PEERS=[]
ROSTER_SYNC_INTERVAL=30
# ROSTER_PEERS is a JSON array: [{"url":"http://peer-alias:8000/api/v2/roster-sync/","token":"peer-server-token"}]
ROSTER_SCHOOL_ID=0
ROSTER_YEAR_ID=0
# Set the exact local school/year IDs before sharing classes. 0 disables roster scope.

# Source ports as published on this server, independent from Docker internal 8000.
# Repository defaults: Test 8080 / Work 8000; existing installations may override.
LOCAL_SERVER_PROFILE_ENABLED=1
LOCAL_SCHOOLTEST_PORT=8080
LOCAL_SCHOOLWORK_PORT=8000
