# setup.sh генерує секрети. Ніколи не комітьте .env.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SCHOOL_REGISTRATION_ENABLED=True
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=schooljournal_db
POSTGRES_USER=journal_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
COMPOSE_PROJECT_NAME=schooljournal
WEB_BIND=0.0.0.0
WEB_PORT=8080
SEED_DEMO_DATA=False
# Залиште порожніми; суперадміна можна створити командою createsuperuser.
FIRST_SUPERADMIN_USERNAME=
FIRST_SUPERADMIN_EMAIL=
FIRST_SUPERADMIN_PASSWORD=
